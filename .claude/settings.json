{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/skills/session-wrap-up/hooks/subagent_notes.py\" || true"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/skills/session-wrap-up/hooks/subagent_notes.py\" || true"}]
      },
      {
        "matcher": "SendMessage",
        "hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/skills/session-wrap-up/hooks/subagent_notes.py\" || true"}]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/skills/session-wrap-up/hooks/subagent_notes.py\" || true"}]
      }
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/skills/session-wrap-up/hooks/subagent_notes.py\" || true"}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/skills/session-wrap-up/hooks/subagent_notes.py\" || true"}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/skills/session-wrap-up/hooks/subagent_notes.py\" || true"}]}
    ]
  }
}
