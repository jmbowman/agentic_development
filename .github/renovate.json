{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>jmbowman/agentic_development//renovate/default"],
  "customManagers": [
    {
      "description": "The cloud-session hook's mise, kept on the same dependency as mise-action's version input so one PR bumps both.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.claude/hooks/session-start\\.sh$/"],
      "matchStrings": ["(?:^|\\n)MISE_VERSION=(?<currentValue>\\S+)\\n"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-release-attachments"
    }
  ]
}
